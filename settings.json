{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-fable-5-1[1m]",
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline.js",
    "padding": 2
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "skill-gate@skill-gate-local": true
  },
  "extraKnownMarketplaces": {
    "skill-gate-local": {
      "source": {
        "source": "directory",
        "path": "C:/Users/lithoshu/.claude/plugins-src/skill-gate"
      }
    }
  },
  "syntaxHighlightingDisabled": false,
  "askUserQuestionTimeout": "never",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "allowedTools": [
    "Bash",
    "PowerShell"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/memory-guard.js",
            "timeout": 10,
            "statusMessage": "memory-guard"
          }
        ]
      }
    ]
  }
}
