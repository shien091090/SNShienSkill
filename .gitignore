# 白名單制: 預設全部忽略, 只手動放行想同步的路徑
*

# 頂層設定檔
!/settings.json
!/statusline.js
!/.gitignore

# 全域使用者指示(每個 session 載入, 跨裝置同步)
!/CLAUDE.md

# 個人本機設定(含明文token等機密, 不進版控)
settings.local.json

# 自訂 output style
!/output-styles/
!/output-styles/**

# 自訂 skills
!/skills/
!/skills/**

# projects/ 不納入版控(內容非預期同步對象)

# skill 執行紀錄(可能含群組名稱等私人資訊), 只同步 skill 本體
/skills/line-group-export/logs/
/skills/unity-mcp-skill/.unity-mcp-skill-sync

# commit 規範(每次 commit 前重讀)
!/rules/
!/rules/**

# hooks(memory-guard 等)
!/hooks/
!/hooks/**
